{
  "name": "@selemondev/create-vue3-app",
  "version": "1.0.0",
  "description": "The Next Generation Vue Scaffolding Tool ✨",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build:package": "tsup-node src/index.ts --target node20 --format cjs,esm --clean --dts --minify --shims",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build:package && node --import tsx --test tests/*.test.ts",
    "lint": "oxlint --deny-warnings",
    "test:templates": "pnpm build:package && node scripts/verify-templates.mjs",
    "generate:release": "pnpx changelogen@latest --release",
    "package:beta": "pnpm build:package && npm publish --tag beta",
    "package": "pnpm build:package && npm publish --access=public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "@selemondev/create-vue3-app": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "template"
  ],
  "keywords": [
    "@selemondev/create-vue3-app",
    "Vue CLI",
    "Vue 3 CLI",
    "Vite CLI",
    "Vite",
    "Vue 3",
    "VueUse",
    "TypeScript"
  ],
  "author": "Selemondev",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/ejs": "^3.1.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.19.43",
    "@types/validate-npm-package-name": "^4.0.2",
    "oxlint": "1.81.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "~7.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^14.0.3",
    "cross-spawn": "^7.0.6",
    "ejs": "^6.0.1",
    "fs-extra": "^11.4.0",
    "prettier": "^3.9.6",
    "validate-npm-package-name": "^7.0.0"
  }
}
